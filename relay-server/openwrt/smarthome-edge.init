#!/bin/sh /etc/rc.common
# OpenWrt procd service script for SmartHome Edge Broker (MediaTek MT7986A ARM64)
# Equipped with Procd auto-respawn and LAN HTTP health watchdog monitoring

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/smarthome-edge
CONF=/etc/smarthome-edge/config.json
WATCHDOG_URL="http://127.0.0.1:9200/api/health/watchdog"

EXTRA_COMMANDS="check_health"
EXTRA_HELP="        check_health Probe /api/health/watchdog and restart if degraded"

start_service() {
    [ -f "$PROG" ] || return 1
    [ -f "$CONF" ] || return 1

    procd_open_instance "smarthome-edge"
    procd_set_param command "$PROG" -config "$CONF"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile /var/run/smarthome-edge.pid
    procd_set_param file "$CONF"
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "smarthome-edge"
}

check_health() {
    HTTP_CODE="000"
    if command -v curl >/dev/null 2>&1; then
        HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" --connect-timeout 5 "$WATCHDOG_URL")
    elif command -v uclient-fetch >/dev/null 2>&1; then
        uclient-fetch -q -s -O /dev/null --timeout=5 "$WATCHDOG_URL" && HTTP_CODE="200" || HTTP_CODE="503"
    elif command -v wget >/dev/null 2>&1; then
        wget -q -O - -T 5 "$WATCHDOG_URL" >/dev/null 2>&1 && HTTP_CODE="200" || HTTP_CODE="503"
    fi

    if [ "$HTTP_CODE" = "200" ]; then
        return 0
    else
        logger -t smarthome-edge "Watchdog health check failed (HTTP $HTTP_CODE). Restarting daemon..."
        /etc/init.d/smarthome-edge restart
        return 1
    fi
}
